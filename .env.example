# Copy to .env and adjust. Never commit a real .env.
# A persistent pepper keeps sessions valid across restarts (generated per-process if unset).
SG_TOKEN_PEPPER=change-me-to-a-long-random-hex-string
SG_ENVIRONMENT=development
SG_COOKIE_SECURE=false
SG_ACTIVE_MODEL=aexgb
SG_SESSION_IDLE_TIMEOUT_MIN=30
SG_SESSION_ABSOLUTE_TIMEOUT_MIN=480
# SG_DATABASE_URL=sqlite:///./backend/data/sessionguard.db
